# Environment Configuration for Court Proceeding Summarizer

# ASR & Whisper Configuration
ASR_MODEL_SIZE=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
BEAM_SIZE=5

# Summarization Engine Settings
DEFAULT_SUMMARIZER=textrank
DEFAULT_SUMMARY_RATIO=0.25
LEGAL_BOOST_ENABLED=true

# Storage and Telemetry
DB_PATH=data/court_jobs.db
OUTPUT_DIR=outputs
UPLOAD_DIR=outputs/uploads

# Server Port
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
